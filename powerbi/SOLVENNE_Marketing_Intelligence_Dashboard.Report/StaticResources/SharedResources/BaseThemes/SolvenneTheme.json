{
  "name": "SOLVENNE_Executive_Vibrant",
  "dataColors": [
    "#0D9488",
    "#4F46E5",
    "#EA580C",
    "#0284C7",
    "#D97706",
    "#7C3AED",
    "#059669",
    "#E11D48",
    "#2563EB",
    "#991B1B"
  ],
  "background": "#F1F5F9",
  "foreground": "#0F172A",
  "tableAccent": "#0D9488",
  "visualStyles": {
    "*": {
      "*": {
        "*": {
          "fontFamily": "Segoe UI"
        },
        "background": [
          {
            "show": true,
            "color": {
