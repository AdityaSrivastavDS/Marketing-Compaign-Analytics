          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "  CATEGORY MIX INSIGHTS\n",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#4F46E5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 1: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0D9488"
                    }
                  },
                  {
                    "value": "Wines generate over half of total revenue ($680.8K / 50.2%), serving as the anchor product line.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 2: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#4F46E5"
                    }
                  },
                  {
                    "value": "Meat products form the secondary pillar ($374.0K / 27.6%), heavily concentrated among high earners.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 3: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#059669"
                    }
                  },
                  {
                    "value": "Upper-middle & high income ($60K+) account for 82.4% of meat spend and 79.1% of wine spend.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 4: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#D97706"
                    }
                  },
                  {
                    "value": "Gold luxury products ($98.6K) demonstrate steady cross-demographic impulse buying.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 5: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#2563EB"
                    }
                  },
                  {
                    "value": "Fruits ($58.9K) and Sweets ($60.6K) serve as low-cost basket builders with frequent replenishment.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
