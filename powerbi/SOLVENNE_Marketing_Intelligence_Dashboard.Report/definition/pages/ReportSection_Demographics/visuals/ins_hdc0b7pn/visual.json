            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "  DEMOGRAPHIC ARCHITECTURE\n",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#4F46E5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 1: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0D9488"
                    }
                  },
                  {
                    "value": "Mature adults (50-64 years) form the largest demographic core at 50.8% of the customer base.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 2: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#4F46E5"
                    }
                  },
                  {
                    "value": "Higher education correlates strongly with income: PhDs average $56,145 vs Basic at $20,306.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 3: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#059669"
                    }
                  },
                  {
                    "value": "71.5% of households have children or teenagers, exhibiting higher price sensitivity and discount demand.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 4: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#D97706"
                    }
                  },
                  {
                    "value": "Spain represents the primary regional hub (48.9%), with Saudi Arabia (15.0%) and Canada (12.0%) next.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Age Plausibility: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#2563EB"
                    }
                  },
                  {
                    "value": "3 records with birth year < 1920 (1893, 1899, 1900) are flagged for analysis without deletion.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              }
            ]
