          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "  CAMPAIGN INTELLIGENCE FINDINGS\n",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#4F46E5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 1: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0D9488"
                    }
                  },
                  {
                    "value": "Prior campaign history is the #1 predictor of conversion: 50.8% response rate vs 5.6% for non-acceptors.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 2: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#4F46E5"
                    }
                  },
                  {
                    "value": "Campaign 4 yielded the highest historical engagement (167 / 7.5%), while Campaign 2 underperformed (30 / 1.3%).\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 3: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#059669"
                    }
                  },
                  {
                    "value": "High-income cohorts ($90K+) convert at 35.4%, compared to under 8.5% for households under $30K.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 4: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#D97706"
                    }
                  },
                  {
                    "value": "Graduate degree holders (PhD at 20.8%, Master at 15.4%) show markedly higher receptivity to campaign offers.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Recommended action: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#2563EB"
                    }
                  },
                  {
                    "value": "Prioritize the 463-customer repeat acceptor segment for upcoming product launches.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
