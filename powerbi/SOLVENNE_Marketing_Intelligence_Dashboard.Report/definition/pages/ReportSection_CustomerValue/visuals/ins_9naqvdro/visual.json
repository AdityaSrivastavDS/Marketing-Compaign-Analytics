            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "  CUSTOMER VALUE ARCHITECTURE\n",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#4F46E5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Pareto Principle confirmed: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0D9488"
                    }
                  },
                  {
                    "value": "Top 2 tiers ($600+ spend) represent 38.5% of customers and 83.2% of spend.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 2: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#4F46E5"
                    }
                  },
                  {
                    "value": "Campaign acceptors generate $1,348 average spend—over 3.2x higher than non-acceptors ($412).\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 3: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#059669"
                    }
                  },
                  {
                    "value": "Last campaign responders average $987 in total product purchases vs $539 for non-responders.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 4: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#D97706"
                    }
                  },
                  {
                    "value": "Recency is uniformly distributed across 0-99 days, indicating steady ongoing customer interaction.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 5: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#2563EB"
                    }
                  },
                  {
                    "value": "Complaint rate is negligible at 0.94% (21 complaints) with zero correlation to spend reduction.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              }
            ]
