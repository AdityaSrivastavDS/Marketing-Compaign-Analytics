    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "  OMNICHANNEL ENGAGEMENT PATTERNS\n",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#4F46E5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 1: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0D9488"
                    }
                  },
                  {
                    "value": "Physical retail stores remain the primary purchase touchpoint (46.2%), followed by Web (32.6%).\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 2: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#4F46E5"
                    }
                  },
                  {
                    "value": "Catalog orders are heavily driven by affluent households ($90K+), accounting for 44.1% of catalog volume.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 3: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#059669"
                    }
                  },
                  {
                    "value": "Web browsing visits average 5.3 visits/month; customers with children exhibit higher visits and deal queries.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 4: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#D97706"
                    }
                  },
                  {
                    "value": "Deal-driven purchases (5,208 total) are most prominent among households earning under $60,000.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "  • Key Takeaway 5: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#2563EB"
                    }
                  },
                  {
                    "value": "Customers utilizing all three purchasing channels spend 2.8x more annually than single-channel buyers.\n",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
