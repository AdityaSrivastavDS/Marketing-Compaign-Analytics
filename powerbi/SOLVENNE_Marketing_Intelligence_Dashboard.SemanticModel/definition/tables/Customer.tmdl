	column Income_Band = SWITCH(TRUE(), ISBLANK(Customer[Income]), "Missing Income", Customer[Income] < 30000, "Low (< $30K)", Customer[Income] < 60000, "Middle ($30K-$60K)", Customer[Income] < 90000, "Upper Middle ($60K-$90K)", "High ($90K+)")
		dataType: string
		lineageTag: c9917053-6f6a-40b0-8941-030d4195ad1c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Income_Status = IF(ISBLANK(Customer[Income]), "Missing Income (24)", "Known Income (2,216)")
		dataType: string
		lineageTag: 1f8b1eba-e05e-4880-b24f-78465d8e4130
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Household_Composition = SWITCH(TRUE(), Customer[Kidhome] = 0 && Customer[Teenhome] = 0, "No Children / Teens", Customer[Kidhome] > 0 && Customer[Teenhome] = 0, "Children Only", Customer[Kidhome] = 0 && Customer[Teenhome] > 0, "Teenagers Only", "Both Children & Teens")
		dataType: string
		lineageTag: ebac7327-3e58-41ab-a26f-a075db7af0cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Has_Children = IF(Customer[Kidhome] > 0, "With Children", "No Children")
		dataType: string
		lineageTag: 6866ad06-6188-41e4-b726-999a03f94636
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Has_Teens = IF(Customer[Teenhome] > 0, "With Teenagers", "No Teenagers")
		dataType: string
		lineageTag: ce0cbdb4-8f67-4336-a632-6681f78c9f2c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Total_Recorded_Spend = Customer[MntWines] + Customer[MntFruits] + Customer[MntMeatProducts] + Customer[MntFishProducts] + Customer[MntSweetProducts] + Customer[MntGoldProds]
		dataType: double
		lineageTag: 22726def-6f45-4d0c-a01d-2090b555ffd3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Total_Purchases = Customer[NumWebPurchases] + Customer[NumCatalogPurchases] + Customer[NumStorePurchases]
		dataType: int64
		lineageTag: 4eb26627-8085-4ec9-b699-3a7beb88faa0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Customer_Value_Tier = SWITCH(TRUE(), Customer[Total_Recorded_Spend] >= 1200, "Tier 1: Elite ($1,200+)", Customer[Total_Recorded_Spend] >= 600, "Tier 2: High ($600-$1,199)", Customer[Total_Recorded_Spend] >= 200, "Tier 3: Moderate ($200-$599)", "Tier 4: Low (< $200)")
		dataType: string
		lineageTag: 1c2e322c-314f-4a21-811f-603a7080ab59
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Recency_Segment = SWITCH(TRUE(), Customer[Recency] < 30, "Active (< 30 days)", Customer[Recency] < 70, "Moderate (30-69 days)", "Lapsed (70+ days)")
		dataType: string
		lineageTag: 321d3e10-6ee6-4ca1-865c-15be0a030a66
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Campaign_Acceptance_Count = Customer[AcceptedCmp1] + Customer[AcceptedCmp2] + Customer[AcceptedCmp3] + Customer[AcceptedCmp4] + Customer[AcceptedCmp5]
		dataType: int64
		lineageTag: 80b3a862-9428-4c24-b55d-32170ed40b0e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Historical_Campaign_Acceptor = IF(Customer[Campaign_Acceptance_Count] > 0, "Accepted >= 1 Campaign", "No Prior Acceptance")
		dataType: string
		lineageTag: 313dff74-e37e-47d1-9fa3-cef8e2623b36
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Last_Campaign_Response_Label = IF(Customer[Response] = 1, "Responded (Offer Accepted)", "Did Not Respond")
		dataType: string
		lineageTag: 3109025c-65b6-46e5-a0c5-cb5812a63e92
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Complaint_Label = IF(Customer[Complain] = 1, "Complained (Last 2 Yrs)", "No Complaint")
