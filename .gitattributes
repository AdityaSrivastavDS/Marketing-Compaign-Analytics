# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Power BI & Fabric JSON and metadata files
*.json text eol=lf
*.bim text eol=lf
*.pbir text eol=lf
*.pbism text eol=lf
*.pbip text eol=lf
*.js text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.csv text eol=lf

# Binary files
*.pbix binary
*.pbit binary
*.abf binary
